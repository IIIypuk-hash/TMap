# Скопируйте в .env и заполните.

# Для продакшена: postgresql+psycopg2://user:password@host:5432/tmap
# Для быстрого локального старта без Postgres можно оставить sqlite:
DATABASE_URL=sqlite:///./tmap.db

# Ключ для подписи JWT-токенов — сгенерируйте случайную строку, например:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

ACCESS_TOKEN_EXPIRE_MINUTES=480

# Ключ Anthropic API для генерации рапортов и извлечения геопривязки.
ANTHROPIC_API_KEY=

# Модель Claude для обработки рапортов.
ANTHROPIC_MODEL=claude-sonnet-5

# Тестовый режим без ключа: true — рапорт оформляется простой эвристикой
# (ключевые слова для категории, regex для адреса) вместо вызова ИИ.
# Годится, чтобы прогнать весь путь (рапорт → правка полей → точка на
# карте → сохранение дела), пока нет платного ключа. На боевом стенде —
# false (или не задавать вовсе).
AI_STUB_MODE=true

# User-Agent, который Nominatim (геокодинг OpenStreetMap) требует указывать явно.
NOMINATIM_USER_AGENT=TMap-internal-ops/1.0 (contact: admin@example.org)

# Логин/пароль сисадмина, создаваемого автоматически при первом запуске,
# если в базе ещё нет ни одного пользователя.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-too

# Через запятую — источники (origin), которым разрешены запросы к API (CORS).
CORS_ORIGINS=http://localhost:8642,http://127.0.0.1:8642
